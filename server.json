{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Bytestay/distill-mcp",
  "description": "Web pages to clean Markdown for AI agents, honouring robots.txt and AI opt-outs.",
  "repository": {
    "url": "https://github.com/bytestay/distill-mcp",
    "source": "github",
    "id": "1445585239"
  },
  "websiteUrl": "https://distill.bytestay.pt/integration.html#mcp-server",
  "version": "0.2.6",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "bytestay-distill-mcp",
      "version": "0.2.6",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "RAPIDAPI_KEY",
          "description": "Your RapidAPI key",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "API_MARKET_KEY",
          "description": "Your api.market key, used when RAPIDAPI_KEY is not set",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "HFL_MARKETPLACE",
          "description": "rapidapi or apimarket, when both keys are set",
          "isRequired": false,
          "isSecret": false,
          "format": "string",
          "choices": [
            "rapidapi",
            "apimarket"
          ]
        }
      ]
    }
  ]
}
